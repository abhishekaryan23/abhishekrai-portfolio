# Security headers for every static file. Cloudflare applies these at the edge
# without running the Worker, so page views stay free and unlimited.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' wss://abhishekrai.dev wss://www.abhishekrai.dev; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests

# Styles, scripts and course engines change rarely; cache for a day, revalidate after.
/assets/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/learn/*/assets/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Plain-text summary for AI assistants
/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
